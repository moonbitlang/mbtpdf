///|
fn hex_fixture(hex : String) -> Array[Byte] {
  let digit = (c : Int) => {
    if c <= '9'.to_int() {
      c - '0'.to_int()
    } else {
      c - 'a'.to_int() + 10
    }
  }
  Array::makei(hex.length() / 2, i => {
    (digit(hex[2 * i].to_int()) * 16 + digit(hex[2 * i + 1].to_int())).to_byte()
  })
}
